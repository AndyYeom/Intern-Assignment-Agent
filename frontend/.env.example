# Backend API base URL, read at request time on the server (root layout).
# This lets the same built image / container point at different backends
# without a rebuild (e.g. different URLs per environment in Docker/ECS).
API_BASE_URL=http://localhost:8000

# Optional build-time fallback only. If API_BASE_URL is not set at runtime,
# the app falls back to this, and if neither is set, to http://localhost:8000.
# Because NEXT_PUBLIC_ variables get inlined into the JS bundle at build time,
# prefer setting API_BASE_URL at runtime instead of relying on this.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
