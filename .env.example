# Copy to .env and fill in. Never commit .env.

# ---- Backend API (src/backend) ---------------------------------------------
# Local `uv run` uses the Compose PostgreSQL on host port 5433. Inside Compose
# the backend overrides this to reach the `postgres` service. On ECS point it
# at RDS, e.g. postgresql+psycopg://user:password@host:5432/utechia
DATABASE_URL=postgresql+psycopg://utechia:local-dev-only@localhost:5433/utechia
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API from a browser.
# "*" allows any origin; only use it for throwaway experiments.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Uploaded resumes (LocalStorage). NOT durable on ECS: use S3 before real use.
STORAGE_ROOT=data/uploads
LOG_LEVEL=INFO

# ---- Docker Compose ----------------------------------------------------------
POSTGRES_DB=utechia
POSTGRES_USER=utechia
POSTGRES_PASSWORD=local-dev-only
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# ---- Frontend (frontend/) ----------------------------------------------------
# Browser-reachable backend URL, read by the Next.js server at request time.
API_BASE_URL=http://localhost:8000

# ---- Agent pipeline ----------------------------------------------------------
# LLM gateway used by the profile, evidence and catalog agents.
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_MODEL=
# Optional: collects applicants' public GitHub data (5,000 requests/hour
# instead of 60). Fine-grained token, public repositories read-only.
GITHUB_TOKEN=

# Catalog agent: OpenAI is used only when OPENAI_API_KEY is set, otherwise the
# LLM gateway above.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Catalog agent terminal admin (python -m project_catalog_agent.admin_setup --help)
APP_NAME=project-catalog-agent
APP_VERSION=0.1.0
ENVIRONMENT=development
CLARIFIER_USERNAME=clarifier
CLARIFIER_PASSWORD_HASH=
ESCALATOR_USERNAME=escalator
ESCALATOR_PASSWORD_HASH=
